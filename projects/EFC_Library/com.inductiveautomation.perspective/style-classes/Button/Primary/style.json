{
  "base": {
    "style": {
      "backgroundColor": "#4D4D4D",
      "color": "#FFFFFF",
      "border": "0.093vh solid #7F7F7F",
      "borderRadius": "0.278vh",
      "fontSize": "1.296vh",
      "fontWeight": "600",
      "fontFamily": "'Noto Sans', 'Segoe UI', Arial, sans-serif",
      "padding": "0.37vh 0.741vh",
      "cursor": "pointer",
      "boxShadow": "none",
      "userSelect": "none",
      "borderColor": "#595959"
    }
  },
  "variants": [
    {
