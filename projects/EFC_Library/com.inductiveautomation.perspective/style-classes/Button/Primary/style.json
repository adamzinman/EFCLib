      }
    },
    {
      "pseudo": "focus",
      "style": {
        "outline": "0.185vh solid #1F4E99",
        "outlineOffset": "0.093vh"
      }
    },
    {
      "pseudo": "disabled",
      "style": {
        "backgroundColor": "#EDEDED",
        "color": "#9A9A9A",
        "borderColor": "#A6A6A6",
        "cursor": "not-allowed"
      }
    }
  ]
