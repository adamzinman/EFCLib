{
  "base": {
    "style": {
      "backgroundColor": "#FFFFFF",
      "color": "#1F1F1F",
      "border": "none",
      "borderRadius": "0px",
      "fontSize": "1.111vh",
      "fontWeight": "600",
      "fontFamily": "'Noto Sans', 'Segoe UI', Arial, sans-serif",
      "padding": "0.37vh 0.741vh",
      "cursor": "pointer",
      "boxShadow": "none",
      "userSelect": "none",
      "borderLeft": "0.37vh solid #4D4D4D",
      "justifyContent": "flex-start",
      "textAlign": "left"
    }
  },
  "variants": [
    {
      "pseudo": "hover",
      "style": {
        "backgroundColor": "#FFFFFF"
      }
    },
    {
      "pseudo": "active",
      "style": {
        "backgroundColor": "#BFBFBF"
      }
    },
    {
      "pseudo": "focus",
      "style": {
        "outline": "0.185vh solid #1F4E99",
        "outlineOffset": "0.093vh"
      }
    },
    {
      "pseudo": "disabled",
      "style": {
        "backgroundColor": "#EDEDED",
        "color": "#9A9A9A",
        "borderColor": "#A6A6A6",
        "cursor": "not-allowed"
      }
    }
  ]
}
