          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/Mode"
        }
      }
    },
    "custom.almHi": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmHi"
        }
      }
    },
    "custom.almLo": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmLo"
        }
      }
    },
    "custom.pvLo": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engLow"
        }
      }
    },
    "custom.pvHi": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engHigh"
        }
      }
    },
    "custom.units": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/PV.engUnit"
        }
      }
    },
    "custom.pvPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.pv} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.spPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.sp} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.hiPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almHi} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.loPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, ({view.custom.almLo} - {view.custom.pvLo}) / max(0.000001, {view.custom.pvHi} - {view.custom.pvLo}) * 100))"
        }
      }
    },
    "custom.outPct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(100, max(0, {view.custom.out}))"
        }
      }
    },
    "custom.alarm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.pv} >= {view.custom.almHi} || {view.custom.pv} <= {view.custom.almLo}"
        }
      }
    },
    "custom.modeText": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.mode}, 0, \"MAN\", 1, \"AUTO\", 2, \"CAS\", \"---\")"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(len({view.params.label}) > 0, {view.params.label}, substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1))"
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.devAlm": {
      "binding": {
        "type": "tag",
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/AlmDev"
        }
      }
    },
    "custom.spark": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(5000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\tbase = self.view.params.tagPath\n\tW, H = 150.0, 34.0\n\tempty = {\"pv\": \"\", \"sp\": \"\"}\n\tif not base:\n\t\treturn empty\n\ttry:\n\t\tds = system.tag.queryTagHistory(paths=[base + \"/PV\", base + \"/SP\"], rangeMinutes=1, returnSize=40,\n\t\t\taggregationMode=\"Average\", returnFormat=\"Wide\", ignoreBadQuality=True)\n\texcept:\n\t\treturn empty\n\trows = []\n\tfor r in range(ds.getRowCount()):\n\t\ta, b = ds.getValueAt(r, 1), ds.getValueAt(r, 2)\n\t\tif a is not None and b is not None:\n\t\t\trows.append((float(a), float(b)))\n\tif len(rows) < 2:\n\t\treturn empty\n\tlo = min(min(p) for p in rows)\n\thi = max(max(p) for p in rows)\n\tpad = max((hi - lo) * 0.15, 0.5)\n\tlo, hi = lo - pad, hi + pad\n\tdef y(val):\n\t\treturn H - 3 - (val - lo) / (hi - lo) * (H - 6)\n\tstep = W / (len(rows) - 1)\n\tdef mk(i):\n\t\treturn \" \".join((\"M\" if n == 0 else \"L\") + \"%.1f,%.1f\" % (n * step, y(p[i])) for n, p in enumerate(rows))\n\treturn {\"pv\": mk(0), \"sp\": mk(1)}"
          }
        ]
      }
    }
  },
