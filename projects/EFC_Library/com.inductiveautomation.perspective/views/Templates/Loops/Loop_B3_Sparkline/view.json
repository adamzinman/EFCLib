          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}/OUT"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "tag",
