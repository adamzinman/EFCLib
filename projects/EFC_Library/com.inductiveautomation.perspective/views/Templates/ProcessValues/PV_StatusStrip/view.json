{
  "custom": {
    "tick": null,
    "pv": null,
    "name": "",
    "desc": "",
    "units": "",
    "hwFault": false,
    "inhHH": false,
    "inhH": false,
    "inhL": false,
    "inhLL": false,
    "aFLT": -1,
    "aHH": -1,
    "aH": -1,
    "aL": -1,
    "aLL": -1,
    "aOVR": -1,
    "aUNR": -1,
    "aFLTalm": -1,
    "alm": {
      "FLT": -1,
      "HH": -1,
      "H": -1,
      "L": -1,
      "LL": -1,
      "OVR": -1,
      "UNR": -1
    },
    "fltActive": false,
    "anyUnacked": false,
    "activePri": -1,
    "clearedPri": -1,
    "inh": false,
    "badValue": false
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.tick": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(1000)"
        }
      }
    },
    "custom.pv": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/PV",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Name",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.desc": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Description",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.units": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/Units",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.hwFault": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/HW_Fault",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.inhHH": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/HH/Inhibit",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.inhH": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/H/Inhibit",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.inhL": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/L/Inhibit",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.inhLL": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{0}/LL/Inhibit",
          "references": {
            "0": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.alm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.tick}"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# One alarm-status query per refresh for this UDT instance. Returns {key: code}:\n\t# -1 = none, else state*10 + priority (state 0 active-acked, 1 active-unacked, 2 cleared-unacked;\n\t# priority 0 Diagnostic .. 4 Critical). Replaces isAlarmActiveFiltered (gateway scope needs the\n\t# provider in the path and Perspective never re-runs it on alarm changes).\n\tout = {\"FLT\": -1, \"HH\": -1, \"H\": -1, \"L\": -1, \"LL\": -1, \"OVR\": -1, \"UNR\": -1}\n\ttp = self.view.params.tagPath\n\tif not tp:\n\t\treturn out\n\ttp = str(tp).strip()\n\tprov = \"*\"\n\tpath = tp\n\tif tp.startswith(\"[\") and \"]\" in tp:\n\t\tprov = tp[1:tp.index(\"]\")] or \"*\"\n\t\tpath = tp[tp.index(\"]\") + 1:]\n\tpath = path.strip(\"/\")\n\tkeys = {\"hw_fault\": \"FLT\", \"hh/alarm\": \"HH\", \"h/alarm\": \"H\", \"l/alarm\": \"L\",\n\t\t\t\"ll/alarm\": \"LL\", \"overrange\": \"OVR\", \"underrange\": \"UNR\"}\n\ttry:\n\t\tevents = system.alarm.queryStatus(source=[\"prov:%s:/tag:%s/*\" % (prov, path)])\n\texcept Exception as e:\n\t\tsystem.util.getLogger(\"EFC_PV\").warn(\"queryStatus failed for %s: %s\" % (tp, e))\n\t\treturn out\n\tagg = {}\n\tfor ev in events:\n\t\tst = str(ev.getState())\n\t\tif st not in (\"ActiveUnacked\", \"ActiveAcked\", \"ClearUnacked\"):\n\t\t\tcontinue\n\t\tsrc = str(ev.getSource())\n\t\tif \":/tag:\" not in src:\n\t\t\tcontinue\n\t\ttag = src.split(\":/tag:\", 1)[1].split(\":/alm:\", 1)[0].strip(\"/\")\n\t\tif not tag.lower().startswith(path.lower() + \"/\"):\n\t\t\tcontinue\n\t\tkey = keys.get(tag[len(path) + 1:].lower())\n\t\tif key is None:\n\t\t\tcontinue\n\t\tpri = int(ev.getPriority().ordinal())\n\t\ta = agg.setdefault(key, {\"act\": -1, \"unack\": False, \"clr\": -1})\n\t\tif st == \"ClearUnacked\":\n\t\t\ta[\"clr\"] = max(a[\"clr\"], pri)\n\t\telse:\n\t\t\ta[\"act\"] = max(a[\"act\"], pri)\n\t\t\tif st == \"ActiveUnacked\":\n\t\t\t\ta[\"unack\"] = True\n\tfor key, a in agg.items():\n\t\tif a[\"act\"] >= 0:\n\t\t\tout[key] = (10 if a[\"unack\"] else 0) + a[\"act\"]\n\t\telif a[\"clr\"] >= 0:\n\t\t\tout[key] = 20 + a[\"clr\"]\n\treturn out"
          }
        ]
      }
    },
    "custom.aFLTalm": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.FLT}, -1)"
        }
      }
    },
    "custom.aFLT": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.aFLTalm} >= 0, {view.custom.aFLTalm},\n  if(toBoolean(coalesce({view.custom.hwFault}, false)), 3, -1))"
        }
      }
    },
    "custom.aHH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.HH}, -1)"
        }
      }
    },
    "custom.aH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.H}, -1)"
        }
      }
    },
    "custom.aL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.L}, -1)"
        }
      }
    },
    "custom.aLL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.LL}, -1)"
        }
      }
    },
    "custom.aOVR": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.OVR}, -1)"
        }
      }
    },
    "custom.aUNR": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.custom.alm.UNR}, -1)"
        }
      }
    },
    "custom.fltActive": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.aFLT} >= 0 && {view.custom.aFLT} < 20"
        }
      }
    },
    "custom.anyUnacked": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "({view.custom.aFLT} >= 10 && {view.custom.aFLT} < 20) || ({view.custom.aHH} >= 10 && {view.custom.aHH} < 20) || ({view.custom.aH} >= 10 && {view.custom.aH} < 20) || ({view.custom.aL} >= 10 && {view.custom.aL} < 20) || ({view.custom.aLL} >= 10 && {view.custom.aLL} < 20) || ({view.custom.aOVR} >= 10 && {view.custom.aOVR} < 20) || ({view.custom.aUNR} >= 10 && {view.custom.aUNR} < 20)"
        }
      }
    },
    "custom.activePri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max(-1, if({view.custom.aHH} >= 0 && {view.custom.aHH} < 20, {view.custom.aHH} % 10, -1), if({view.custom.aH} >= 0 && {view.custom.aH} < 20, {view.custom.aH} % 10, -1), if({view.custom.aL} >= 0 && {view.custom.aL} < 20, {view.custom.aL} % 10, -1), if({view.custom.aLL} >= 0 && {view.custom.aLL} < 20, {view.custom.aLL} % 10, -1), if({view.custom.aOVR} >= 0 && {view.custom.aOVR} < 20, {view.custom.aOVR} % 10, -1), if({view.custom.aUNR} >= 0 && {view.custom.aUNR} < 20, {view.custom.aUNR} % 10, -1))"
        }
      }
    },
    "custom.clearedPri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max(-1, if({view.custom.aHH} >= 20, {view.custom.aHH} % 10, -1), if({view.custom.aH} >= 20, {view.custom.aH} % 10, -1), if({view.custom.aL} >= 20, {view.custom.aL} % 10, -1), if({view.custom.aLL} >= 20, {view.custom.aLL} % 10, -1), if({view.custom.aOVR} >= 20, {view.custom.aOVR} % 10, -1), if({view.custom.aUNR} >= 20, {view.custom.aUNR} % 10, -1))"
        }
      }
    },
    "custom.inh": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "toBoolean(coalesce({view.custom.inhHH}, false)) || toBoolean(coalesce({view.custom.inhH}, false)) || toBoolean(coalesce({view.custom.inhL}, false)) || toBoolean(coalesce({view.custom.inhLL}, false))"
        }
      }
    },
    "custom.badValue": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!isGood({view.custom.pv}) || {view.custom.fltActive}"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 104,
      "height": 54
    }
  },
  "root": {
    "type": "ia.container.flex",
    "version": 0,
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "justify": "flex-start",
      "alignItems": "stretch",
      "wrap": "nowrap",
      "style": {
        "classes": "PV/Shell"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "version": 0,
        "meta": {
          "name": "Card"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "direction": "row",
          "justify": "flex-start",
          "alignItems": "stretch",
          "wrap": "nowrap",
          "style": {
            "classes": "PV/Card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "version": 0,
            "meta": {
              "name": "Strip"
            },
            "position": {
              "basis": "0.37vh",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "PV/Strip/Normal"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.fltActive}, \"PV/Strip/Fault\" + if({view.custom.anyUnacked}, \" Alarm/Mod/Blink\", \"\"),\n if({view.custom.activePri} >= 0, \"PV/Strip/\" + case({view.custom.activePri}, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.anyUnacked}, \" Alarm/Mod/Blink\", \"\"),\n  if({view.custom.aFLT} >= 20, \"PV/Strip/Fault Alarm/Mod/ClearedUnacked\",\n   if({view.custom.clearedPri} >= 0, \"PV/Strip/\" + case({view.custom.clearedPri}, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + \" Alarm/Mod/ClearedUnacked\",\n    \"PV/Strip/Normal\"))))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "version": 0,
            "meta": {
              "name": "Body"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "direction": "column",
              "justify": "space-between",
              "alignItems": "stretch",
              "wrap": "nowrap",
              "style": {
                "classes": "PV/Body"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "version": 0,
                "meta": {
                  "name": "HeaderRow"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "direction": "row",
                  "justify": "space-between",
                  "alignItems": "center",
                  "wrap": "nowrap",
                  "style": {
                    "classes": "PV/HeaderRow"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "version": 0,
                    "meta": {
                      "name": "Tag",
                      "tooltip": {
                        "enabled": true,
                        "text": ""
                      }
                    },
                    "position": {
                      "basis": "auto",
                      "grow": 1,
                      "shrink": 1
                    },
                    "props": {
                      "text": "PT002",
                      "style": {
                        "classes": "PV/Tag Text/Mod/Ellipsis"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if(isNull({view.custom.name}) || len(toStr({view.custom.name})) = 0 || toStr({view.custom.name}) = \"null\",\n  substring({view.params.tagPath}, max(lastIndexOf({view.params.tagPath}, \"/\"), lastIndexOf({view.params.tagPath}, \"]\")) + 1),\n  toStr({view.custom.name}))"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if(isNull({view.custom.desc}) || toStr({view.custom.desc}) = \"null\", \"\", toStr({view.custom.desc}))"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.container.flex",
                    "version": 0,
                    "meta": {
                      "name": "Chips"
                    },
                    "position": {
                      "basis": "auto",
                      "grow": 0,
                      "shrink": 0
                    },
                    "props": {
                      "direction": "row",
                      "justify": "flex-end",
                      "alignItems": "center",
                      "wrap": "nowrap",
                      "style": {
                        "classes": "PV/ChipRow"
                      }
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_FLT",
                          "tooltip": {
                            "enabled": true,
                            "text": "Hardware / transmitter fault"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "FLT",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aFLT} >= 0) && 0 < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aFLT} < 0, \"PV/Chip/Fault\", \"PV/Chip/Fault\" + if({view.custom.aFLT} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aFLT} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_HH",
                          "tooltip": {
                            "enabled": true,
                            "text": "High-high alarm"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "HH",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aHH} >= 0) && (if({view.custom.aFLT} >= 0, 1, 0)) < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aHH} < 0, \"\", \"PV/Chip/\" + case({view.custom.aHH} % 10, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.aHH} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aHH} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_H",
                          "tooltip": {
                            "enabled": true,
                            "text": "High alarm"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "H",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aH} >= 0) && (if({view.custom.aFLT} >= 0, 1, 0) + if({view.custom.aHH} >= 0, 1, 0)) < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aH} < 0, \"\", \"PV/Chip/\" + case({view.custom.aH} % 10, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.aH} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aH} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_L",
                          "tooltip": {
                            "enabled": true,
                            "text": "Low alarm"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "L",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aL} >= 0) && (if({view.custom.aFLT} >= 0, 1, 0) + if({view.custom.aHH} >= 0, 1, 0) + if({view.custom.aH} >= 0, 1, 0)) < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aL} < 0, \"\", \"PV/Chip/\" + case({view.custom.aL} % 10, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.aL} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aL} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_LL",
                          "tooltip": {
                            "enabled": true,
                            "text": "Low-low alarm"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "LL",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
                          "position.display": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "({view.custom.aLL} >= 0) && (if({view.custom.aFLT} >= 0, 1, 0) + if({view.custom.aHH} >= 0, 1, 0) + if({view.custom.aH} >= 0, 1, 0) + if({view.custom.aL} >= 0, 1, 0)) < 2"
                              }
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "if({view.custom.aLL} < 0, \"\", \"PV/Chip/\" + case({view.custom.aLL} % 10, 4, \"Critical\", 3, \"High\", 2, \"Medium\", 1, \"Low\", \"Diagnostic\") + if({view.custom.aLL} >= 20, \" Alarm/Mod/ClearedUnacked\", if({view.custom.aLL} >= 10, \" Alarm/Mod/Blink\", \"\")))"
                              }
                            }
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "version": 0,
                        "meta": {
                          "name": "Chip_OVR",
                          "tooltip": {
                            "enabled": true,
                            "text": "Signal over range"
                          }
                        },
                        "position": {
                          "basis": "auto",
                          "grow": 0,
                          "shrink": 0,
                          "display": false
                        },
                        "props": {
                          "text": "OVR",
                          "style": {
                            "classes": ""
                          }
                        },
                        "propConfig": {
