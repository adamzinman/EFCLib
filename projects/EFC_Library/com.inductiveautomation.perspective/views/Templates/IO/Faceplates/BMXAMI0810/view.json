                  "style": {
                    "classes": "Table/Header"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "H_Bar"
                },
                "position": {
                  "basis": "10.926vh",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
