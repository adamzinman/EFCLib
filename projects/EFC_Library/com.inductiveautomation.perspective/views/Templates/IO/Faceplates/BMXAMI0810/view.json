                    "classes": "Table/Header"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "H_Desc"
                },
                "position": {
                  "basis": "0",
                  "grow": 1,
                  "shrink": 1
                },
                "props": {
