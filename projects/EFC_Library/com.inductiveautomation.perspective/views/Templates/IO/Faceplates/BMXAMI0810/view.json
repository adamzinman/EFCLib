                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.flex-repeater",
            "version": 0,
            "meta": {
              "name": "Rows"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "path": "Templates/IO/Parts/AnalogRow_AI",
              "instances": [],
              "direction": "column",
              "wrap": "nowrap",
              "justify": "flex-start",
              "alignItems": "flex-start",
              "alignContent": "flex-start",
              "useDefaultViewWidth": true,
              "useDefaultViewHeight": true,
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "style": {
                "classes": ""
              }
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.params.cardPath}"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\tn = 8\n\tp = str(value or '')\n\tif not p:\n\t\treturn []\n\treturn [{'cardPath': p, 'ch': i, 'chFolder': 'CH%02d' % i, 'alt': (i % 2 == 1)} for i in range(0, 8)]"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    ]
  }
}
