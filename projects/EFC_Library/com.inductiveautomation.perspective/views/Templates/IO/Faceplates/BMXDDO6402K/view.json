              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "version": 0,
                "meta": {
                  "name": "GroupLbl0"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "text": "OUTPUTS 00–15",
                  "style": {
                    "classes": "Text/Subheader"
                  }
                }
              },
              {
                "type": "ia.display.flex-repeater",
                "version": 0,
                "meta": {
                  "name": "Tiles0"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "path": "Templates/IO/Parts/DiscreteTile",
                  "instances": [],
                  "direction": "row",
                  "wrap": "wrap",
                  "justify": "flex-start",
                  "alignItems": "flex-start",
                  "alignContent": "flex-start",
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": true,
                  "elementPosition": {
                    "basis": "12.5%",
                    "grow": 0,
                    "shrink": 0
                  },
                  "style": {
                    "classes": ""
                  }
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.params.cardPath}"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\tn = 16\n\tp = str(value or '')\n\tif not p:\n\t\treturn []\n\treturn [{'cardPath': p, 'ch': i, 'chFolder': 'CH%02d' % i, 'alt': (i % 2 == 1)} for i in range(0, 16)]"
                        }
                      ]
