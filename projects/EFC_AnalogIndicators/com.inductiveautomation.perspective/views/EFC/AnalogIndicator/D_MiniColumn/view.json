          "mode": "indirect",
          "tagPath": "{1}/Alm_HH/Cfg_En",
          "references": {
            "1": "{view.params.TagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.hhA": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm_HH/Sts_Active",
          "references": {
            "1": "{view.params.TagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.hhU": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm_HH/Sts_Unack",
          "references": {
            "1": "{view.params.TagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.hhP": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{1}/Alm_HH/Cfg_Priority",
          "references": {
            "1": "{view.params.TagPath}"
          },
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.good": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.custom.q} != 2"
        }
      }
    },
    "custom.span": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.max} - {view.custom.min}, 0.000001)"
        }
      }
    },
    "custom.p": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(max(({view.custom.pv} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100"
        }
      }
    },
    "custom.pLL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(max(({view.custom.ll} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100"
        }
      }
    },
    "custom.pL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(max(({view.custom.l} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100"
        }
      }
    },
    "custom.pH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(max(({view.custom.h} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100"
        }
      }
    },
    "custom.pHH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "min(max(({view.custom.hh} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100"
        }
      }
    },
    "custom.pIL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.iLo} < {view.custom.iHi}, min(max(({view.custom.iLo} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100, {view.custom.pL})"
        }
      }
    },
    "custom.pIH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.iLo} < {view.custom.iHi}, min(max(({view.custom.iHi} - {view.custom.min}) / {view.custom.span}, 0), 1) * 100, {view.custom.pL})"
        }
      }
    },
    "custom.lvl": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.hhA}, 'HH', if({view.custom.llA}, 'LL', if({view.custom.hA}, 'H', if({view.custom.lA}, 'L', ''))))"
        }
      }
    },
    "custom.almUnack": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.lvl}, 'HH', {view.custom.hhU}, 'LL', {view.custom.llU}, 'H', {view.custom.hU}, 'L', {view.custom.lU}, false)"
        }
      }
    },
    "custom.almPri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case({view.custom.lvl}, 'HH', {view.custom.hhP}, 'LL', {view.custom.llP}, 'H', {view.custom.hP}, 'L', {view.custom.lP}, 3)"
        }
      }
    },
    "custom.pri": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case(toInt({view.custom.almPri}), 1, 'Critical', 2, 'High', 3, 'Medium', 4, 'Low', 'Medium')"
        }
      }
    },
    "custom.almCls": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = '', '', 'Alarm/' + {view.custom.pri} + if({view.custom.almUnack}, '/Unacked', '/Fill'))"
        }
      }
    },
    "custom.ptrColor": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = '', '#1F1F1F', case({view.custom.pri}, 'Critical', '#D50000', 'High', '#FF7A00', 'Medium', '#FFD200', 'Low', '#00A3E0', '#6E6E6E'))"
        }
      }
    },
    "custom.valCls": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "'Indicator/Analog/ValueBox' + if(!{view.custom.good}, ' Value/BadQuality', if({view.custom.lvl} != '', ' Alarm/' + {view.custom.pri} + '/Outline', if({view.custom.q} = 1, ' Value/Simulated', '')))"
        }
      }
    },
    "custom.valText": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "numberFormat({view.custom.pv}, {view.params.Format})"
        }
      }
    },
    "custom.chipVis": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!{view.custom.good} || {view.custom.lvl} != ''"
        }
      }
    },
    "custom.chipCls": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "'Indicator/Analog/Chip ' + if(!{view.custom.good}, 'Indicator/Analog/ChipBad', {view.custom.almCls})"
        }
      }
    },
    "custom.zLL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pLL}, 0) + '%'"
        }
      }
    },
    "custom.zL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pL} - {view.custom.pLL}, 0) + '%'"
        }
      }
    },
    "custom.zW1": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pIL} - {view.custom.pL}, 0) + '%'"
        }
      }
    },
    "custom.zI": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pIH} - {view.custom.pIL}, 0) + '%'"
        }
      }
    },
    "custom.zW2": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pH} - {view.custom.pIH}, 0) + '%'"
        }
      }
    },
    "custom.zH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max({view.custom.pHH} - {view.custom.pH}, 0) + '%'"
        }
      }
    },
    "custom.zHH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "max(100 - {view.custom.pHH}, 0) + '%'"
        }
      }
    },
    "custom.cLL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = 'LL', {view.custom.almCls}, if({view.custom.llEn}, 'Indicator/Analog/ZoneLL', if({view.custom.lEn}, 'Indicator/Analog/ZoneL', 'Indicator/Analog/ZoneNormal')))"
        }
      }
    },
    "custom.cL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = 'L', {view.custom.almCls}, if({view.custom.lEn}, 'Indicator/Analog/ZoneL', 'Indicator/Analog/ZoneNormal'))"
        }
      }
    },
    "custom.cH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = 'H', {view.custom.almCls}, if({view.custom.hEn}, 'Indicator/Analog/ZoneL', 'Indicator/Analog/ZoneNormal'))"
        }
      }
    },
    "custom.cHH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.lvl} = 'HH', {view.custom.almCls}, if({view.custom.hhEn}, 'Indicator/Analog/ZoneLL', if({view.custom.hEn}, 'Indicator/Analog/ZoneL', 'Indicator/Analog/ZoneNormal')))"
        }
      }
    },
    "params.TagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Header": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Format": {
      "paramDirection": "input",
      "persistent": true
    }
  },
